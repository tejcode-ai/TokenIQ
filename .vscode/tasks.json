{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TokenIQ: Run API",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "TokenIQ: Run tests",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
